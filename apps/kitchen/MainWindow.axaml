<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SugarERP.Kitchen.App.MainWindow" Title="Sugar ERP — المطبخ" Width="1280" Height="800" MinWidth="900" MinHeight="650" CanResize="True" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="#FFF7FA">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#75264A" Padding="16"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel><TextBlock Text="Sugar ERP · المطبخ" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="طلبات الفروع والإرسال عبر الخادم" Foreground="#FFD9E8"/></StackPanel><Button Grid.Column="1" Name="UpdateButton" Content="Check for Updates" Click="Update_Click" Margin="4"/><Button Grid.Column="2" Name="SyncButton" Content="مزامنة الآن" Click="Sync_Click" Margin="4"/></Grid></Border>
    <TabControl Grid.Row="1" Margin="12">
      <TabItem Header="طلبات الفروع"><Grid RowDefinitions="Auto,*"><TextBlock Name="StatusText" Margin="8" FontSize="16" TextWrapping="Wrap"/><ListBox Grid.Row="1" Name="RequestsList" SelectionChanged="Request_Selected"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="2" Background="White" CornerRadius="8"><StackPanel><TextBlock Text="{Binding BranchName}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding SubmittedAtUtc}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="تجهيز وإرسال"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Name="SelectedTitle" FontSize="23" FontWeight="Bold" Margin="8"/><DataGrid Grid.Row="1" Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="المطلوب" Binding="{Binding RequestedDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="تم إرساله" Binding="{Binding SentDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="إرسال الآن" Binding="{Binding SendDisplay}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="تأكيد الشحنة وإرسالها" HorizontalAlignment="Right" MinWidth="240" Margin="8" Click="Dispatch_Click"/></Grid></TabItem>
      <TabItem Header="الاستلام والخلافات"><Grid RowDefinitions="*,Auto,*"><DataGrid Name="ReceiptsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الشحنة" Binding="{Binding ShipmentId}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchSiteId}" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="وقت العد" Binding="{Binding CountedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="مرتجعات الفروع إلى المطبخ" FontWeight="Bold" Margin="8"/><DataGrid Grid.Row="2" Name="ReturnsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchSiteId}" Width="*"/><DataGridTextColumn Header="وقت الإرسال" Binding="{Binding DispatchedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="الخامات والجرد"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="8" Spacing="6"><TextBlock Text="حركة الخامات" FontSize="23" FontWeight="Bold"/><TextBlock Text="أدخل الكمية في عمود العملية. الاستلام يزيد الرصيد، والهالك يخصمه، والجرد يستبدل الرصيد بالكمية الفعلية." TextWrapping="Wrap"/><TextBox Name="InventoryReason" PlaceholderText="سبب الاستلام أو الهالك (إلزامي)"/></StackPanel><DataGrid Grid.Row="1" Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentDisplay}" Width="190" IsReadOnly="True"/><DataGridTextColumn Header="كمية العملية / العد الفعلي" Binding="{Binding InputDisplay}" Width="240"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="8"><Button Grid.Column="0" Content="تسجيل استلام" Click="ReceiveIngredients_Click" Margin="4"/><Button Grid.Column="1" Content="تسجيل هالك" Click="WasteIngredients_Click" Margin="4"/><Button Grid.Column="2" Content="إقفال جرد اليوم" Click="CountIngredients_Click" Margin="4"/></Grid></Grid></TabItem>
      <TabItem Header="الطلبات الخاصة"><Grid RowDefinitions="Auto,*,Auto,*,Auto" ColumnDefinitions="*,*" Margin="8"><StackPanel Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="طلبات الكافيهات والسوبر ماركت" FontSize="23" FontWeight="Bold"/><TextBlock Text="تُحفظ الفاتورة وتُرسل للخادم أولاً، ثم يمكن طباعتها أو إعادة طباعتها دون تكرار المعاملة." TextWrapping="Wrap"/><ComboBox Name="CafeCustomer" PlaceholderText="اختر العميل" SelectionChanged="CafeCustomer_Selected"/><TextBox Name="CustomDue" PlaceholderText="موعد التسليم: 2026-09-20 18:30"/><TextBox Name="CustomDescription" PlaceholderText="ملاحظات الطلب"/></StackPanel><DataGrid Grid.Row="1" Grid.ColumnSpan="2" Name="CafeItemsGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="السعر" Binding="{Binding PriceDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Grid.ColumnSpan="2" Content="حفظ الفاتورة وإرسالها" Click="CreateCustomOrder_Click" Margin="4"/><DataGrid Grid.Row="3" Grid.ColumnSpan="2" Name="CustomOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="الفاتورة" Binding="{Binding OrderNumber}" Width="180"/><DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="التسليم" Binding="{Binding DueDisplay}" Width="200"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="150"/></DataGrid.Columns></DataGrid><Button Grid.Row="4" Grid.ColumnSpan="2" Content="طباعة / إعادة طباعة الفاتورة المحددة" Click="PrintCustomOrder_Click" Margin="4"/></Grid></TabItem>
      <TabItem Header="الإعدادات"><StackPanel Spacing="10" MaxWidth="720" Margin="18"><TextBlock Text="Excel ومجلد التقارير" FontWeight="Bold"/><TextBox Name="ReportsDirectory" IsReadOnly="True"/><Button Content="تغيير المجلد..." Click="ReportsFolder_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="طابعة الإيصالات" FontWeight="Bold"/><ComboBox Name="PrinterName" PlaceholderText="اختر طابعة حرارية"/><Button Content="اختبار الطابعة" Click="PrinterTest_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="ربط هذا الجهاز بموقع مطبخ" FontSize="18" FontWeight="Bold"/><TextBlock Text="أنشئ رمز تسجيل لموقع من نوع مطبخ من لوحة الإدارة. بيانات الدخول تحفظ محمية لحساب Windows الحالي." TextWrapping="Wrap"/><TextBox Name="ApiUrl" Text="https://ascendyz.xyz/api/v1" PlaceholderText="عنوان API"/><TextBox Name="EnrollmentToken" PlaceholderText="رمز التسجيل لمرة واحدة"/><TextBox Name="DeviceName" PlaceholderText="اسم الجهاز"/><Button Content="ربط الجهاز" Click="Enroll_Click"/></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
