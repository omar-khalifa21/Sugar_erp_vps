<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SugarERP.Kitchen.App.MainWindow" Title="Sugar ERP — المطبخ" Width="1280" Height="800" MinWidth="1000" MinHeight="680" FlowDirection="RightToLeft" Background="#F7F8FC">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#75264A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.home-card"><Setter Property="MinHeight" Value="132"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5D9E0"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="TextBlock.screen-title"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#202333"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#747B8F"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="#75264A" Padding="18,14"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Button Name="HomeButton" Content="⌂ الرئيسية" Click="Home_Click" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="Sugar ERP · المطبخ" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="المخزون والوصفات وطلبات الفروع" Foreground="#FFD9E8"/></StackPanel><Button Grid.Column="2" Name="UpdateButton" Content="التحديثات" Click="Update_Click" Margin="4"/><Button Grid.Column="3" Name="SyncButton" Content="تحديث يدوي" Click="Sync_Click" Margin="4"/></Grid></Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4E6EF" BorderThickness="0,0,0,1" Padding="14,9"><Grid ColumnDefinitions="Auto,*"><Border Name="SyncBadge" Background="#E9F8EF" CornerRadius="999" Padding="12,6"><TextBlock Name="SyncStateText" Text="متزامن" Foreground="#237A49" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Name="StatusText" Margin="14,4" FontSize="14" TextWrapping="Wrap" Foreground="#5E6578"/></Grid></Border>
    <TabControl Grid.Row="2" Name="MainTabs" Margin="14" TabStripPlacement="Top">
      <TabItem Header="الرئيسية"><ScrollViewer><StackPanel Spacing="18" Margin="4"><StackPanel><TextBlock Classes="screen-title" Text="لوحة المطبخ"/><TextBlock Classes="muted" Text="اختر الوحدة التي تريد العمل عليها. تتم المزامنة تلقائياً في الخلفية."/></StackPanel><UniformGrid Columns="5" Rows="1">
        <Button Classes="home-card" Click="OpenStock_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="المخزون" FontSize="22" FontWeight="Bold"/><TextBlock Text="استلام خامات، هالك، وجرد" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeLowStock" Text="—" Foreground="#B54708"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenRecipes_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="الوصفات" FontSize="22" FontWeight="Bold"/><TextBlock Text="وصفات المنتجات واستهلاك الخامات" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRecipes" Text="—"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenRequests_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="الوارد" FontSize="22" FontWeight="Bold"/><TextBlock Text="طلبات الفروع والتجهيز والإرسال" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRequests" Text="—" Foreground="#75264A"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenOrders_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="طلبات الكافيهات" FontSize="22" FontWeight="Bold"/><TextBlock Text="إنشاء وطباعة الطلبات الخاصة" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeOrders" Text="—"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenItems_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="الأصناف" FontSize="22" FontWeight="Bold"/><TextBlock Text="عرض وإنشاء الأصناف العامة" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeItems" Text="—"/></StackPanel></Button>
      </UniformGrid><Grid ColumnDefinitions="2*,*" ColumnSpacing="14"><Border Classes="panel"><StackPanel Spacing="10"><TextBlock Text="ملخص التشغيل" FontSize="18" FontWeight="Bold"/><Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Name="PendingSyncCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="بانتظار المزامنة" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Name="IngredientCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="خامات مسجلة" Classes="muted"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Name="PendingRequestCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="طلبات قيد التنفيذ" Classes="muted"/></StackPanel></Grid></StackPanel></Border><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="حالة الخادم" FontSize="18" FontWeight="Bold"/><TextBlock Name="ServerStatusText" Text="سيتم الفحص تلقائياً" Classes="muted" TextWrapping="Wrap"/><Button Content="فتح الإعدادات" Click="OpenSettings_Click"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="الوارد"><Grid RowDefinitions="Auto,*" Margin="6"><StackPanel Spacing="8"><TextBlock Classes="screen-title" Text="وارد الفروع"/><TextBlock Classes="muted" Text="تظهر الطلبات وتتغير حالتها تلقائياً بدون زر مزامنة."/><WrapPanel><Button Name="PendingFilter" Content="Pending · قيد الانتظار" Click="PendingFilter_Click" Margin="3"/><Button Name="SentFilter" Content="Sent · تم الإرسال" Click="SentFilter_Click" Margin="3"/><Button Name="ConfirmedFilter" Content="Confirmed · مؤكد" Click="ConfirmedFilter_Click" Margin="3"/><Button Name="ConflictedFilter" Content="Conflicted · مختلف" Click="ConflictedFilter_Click" Margin="3"/></WrapPanel></StackPanel><Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12"><ListBox Name="RequestsList" SelectionChanged="Request_Selected"><ListBox.ItemTemplate><DataTemplate><Border Classes="panel" Padding="14" Margin="3"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding BranchName}" FontWeight="Bold" FontSize="18"/><Border Grid.Column="1" Background="#F3EAF0" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding Status}" Foreground="#75264A" FontWeight="Bold"/></Border></Grid><TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/><TextBlock Text="{Binding SubmittedDisplay}" Classes="muted"/><TextBlock Text="{Binding ItemCountDisplay}" Classes="muted"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Classes="panel"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Spacing="5"><TextBlock Name="SelectedTitle" Classes="screen-title" Text="اختر طلباً"/><TextBlock Name="SelectedSubtitle" Classes="muted" Text="افتح الطلب لمراجعة الكميات."/></StackPanel><DataGrid Grid.Row="1" Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="المطلوب" Binding="{Binding RequestedDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="الكمية المرسلة" Binding="{Binding SendDisplay}" Width="180"/><DataGridTextColumn Header="التغيير" Binding="{Binding ChangeDisplay}" Width="180" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Name="DispatchButton" Classes="primary" Content="Confirm &amp; Send · تأكيد وإرسال" HorizontalAlignment="Right" MinWidth="300" Margin="8" Click="Dispatch_Click" IsVisible="False"/></Grid></Border></Grid></Grid></TabItem>
      <TabItem Header="المرتجعات"><Grid RowDefinitions="Auto,*"><TextBlock Classes="screen-title" Text="مرتجعات الفروع إلى المطبخ" Margin="8"/><DataGrid Grid.Row="1" Name="ReturnsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchSiteId}" Width="*"/><DataGridTextColumn Header="وقت الإرسال" Binding="{Binding DispatchedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="مخزون الخامات"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="8" Spacing="7"><TextBlock Classes="screen-title" Text="مخزون الخامات"/><TextBlock Classes="muted" Text="اختر الخامة والكمية وسعر الشراء الإجمالي. يحسب البرنامج تكلفة الوحدة تلقائياً."/><WrapPanel><ComboBox Name="PurchaseIngredient" Width="220" PlaceholderText="اختر الخامة" Margin="3"/><TextBox Name="PurchaseQuantity" Width="115" PlaceholderText="الكمية" Margin="3"/><ComboBox Name="PurchaseUnit" Width="105" SelectedIndex="0" Margin="3"><ComboBoxItem Content="g"/><ComboBoxItem Content="kg"/><ComboBoxItem Content="ml"/><ComboBoxItem Content="L"/><ComboBoxItem Content="قطعة"/></ComboBox><TextBox Name="PurchaseCost" Width="150" PlaceholderText="التكلفة الإجمالية ج.م" Margin="3"/><Button Classes="primary" Content="إضافة شراء" Click="ReceiveIngredients_Click" Margin="3"/></WrapPanel><TextBox Name="InventoryReason" Text="شراء خامات" PlaceholderText="سبب الشراء أو الهالك"/></StackPanel><DataGrid Grid.Row="1" Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الحالي" Binding="{Binding CurrentDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding AverageCostDisplay}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="المتوقع" Binding="{Binding ExpectedDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="كمية الهالك / الجرد" Binding="{Binding InputDisplay}" Width="190"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="8"><Button Content="هالك / إتلاف" Click="WasteIngredients_Click" Margin="4"/><Button Grid.Column="1" Content="إقفال جرد اليوم" Click="CountIngredients_Click" Margin="4"/></Grid></Grid></TabItem>
      <TabItem Header="الوصفات"><Grid RowDefinitions="Auto,*,Auto" Margin="8"><StackPanel Spacing="6"><TextBlock Classes="screen-title" Text="وصفات المنتجات"/><TextBlock Classes="muted" Text="اختر منتجاً، أضف خاماته، ثم احفظ الوصفة. يظهر سعر التكلفة المحسوب من المخزون."/><WrapPanel><ComboBox Name="RecipeProduct" Width="250" PlaceholderText="اختر المنتج" SelectionChanged="RecipeProduct_Selected" Margin="3"/><TextBox Name="RecipeOutput" Width="150" Text="1" PlaceholderText="كمية الناتج" Margin="3"/><TextBlock Name="RecipeCost" Text="التكلفة: —" VerticalAlignment="Center" Margin="12,3"/></WrapPanel><WrapPanel><ComboBox Name="RecipeIngredient" Width="220" PlaceholderText="اختر الخامة" Margin="3"/><TextBox Name="RecipeQuantity" Width="110" PlaceholderText="الكمية" Margin="3"/><ComboBox Name="RecipeUnit" Width="100" SelectedIndex="0" Margin="3"><ComboBoxItem Content="g"/><ComboBoxItem Content="kg"/><ComboBoxItem Content="ml"/><ComboBoxItem Content="L"/><ComboBoxItem Content="قطعة"/></ComboBox><Button Content="أضف للوصفة" Click="AddRecipeIngredient_Click" Margin="3"/></WrapPanel></StackPanel><DataGrid Grid.Row="1" Name="RecipeComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityDisplay}" Width="180"/><DataGridTextColumn Header="التكلفة" Binding="{Binding CostDisplay}" Width="160"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2"><Button Content="حذف المكون المحدد" Click="RemoveRecipeIngredient_Click" Margin="4"/><Button Classes="primary" Content="حفظ الوصفة ومزامنتها" Click="SaveRecipe_Click" Margin="4"/></WrapPanel></Grid></TabItem>
      <TabItem Header="الكافيهات"><Grid RowDefinitions="Auto,*,Auto,*,Auto" ColumnDefinitions="*,*" Margin="8"><StackPanel Grid.ColumnSpan="2" Spacing="6"><TextBlock Classes="screen-title" Text="الكافيهات والطلبات"/><WrapPanel><ComboBox Name="CafeCustomer" Width="250" PlaceholderText="اختر الكافيه" SelectionChanged="CafeCustomer_Selected" Margin="3"/><TextBox Name="CafeName" Width="220" PlaceholderText="اسم الكافيه" Margin="3"/><TextBox Name="CafeContact" Width="160" PlaceholderText="رقم الاتصال" Margin="3"/><Button Content="كافيه جديد" Click="NewCafe_Click" Margin="3"/><Button Classes="primary" Content="حفظ الكافيه" Click="SaveCafe_Click" Margin="3"/></WrapPanel><TextBox Name="CustomDue" PlaceholderText="موعد التسليم: 2026-09-21 18:30"/><TextBox Name="CustomDescription" PlaceholderText="ملاحظات الطلب"/></StackPanel><DataGrid Grid.Row="1" Grid.ColumnSpan="2" Name="CafeItemsGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="السعر" Binding="{Binding PriceDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Grid.ColumnSpan="2" Classes="primary" Content="حفظ الطلب وإرساله" Click="CreateCustomOrder_Click" Margin="4"/><DataGrid Grid.Row="3" Grid.ColumnSpan="2" Name="CustomOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الفاتورة" Binding="{Binding OrderNumber}" Width="180"/><DataGridTextColumn Header="الكافيه" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="التسليم" Binding="{Binding DueDisplay}" Width="200"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="150"/><DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="140"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="4" Grid.ColumnSpan="2"><Button Classes="primary" Content="تأكيد تجهيز وتسليم الطلب" Click="DeliverCafeOrder_Click" Margin="4"/><Button Content="طباعة الفاتورة" Click="PrintCustomOrder_Click" Margin="4"/></WrapPanel></Grid></TabItem>
      <TabItem Header="المنتجات والخامات"><Grid RowDefinitions="Auto,*" Margin="8"><WrapPanel Margin="0,0,0,10"><TextBlock Classes="screen-title" Text="المنتجات" Margin="8"/><Button Classes="primary" Content="+ منتج جديد" Click="NewProduct_Click" Margin="8"/><TextBlock Classes="screen-title" Text="الخامات" Margin="8"/><Button Content="+ خامة جديدة" Click="NewIngredient_Click" Margin="8"/></WrapPanel><Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12"><Grid RowDefinitions="*,*" RowSpacing="8"><DataGrid Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Item_Selected"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="سعر البيع الأساسي" Binding="{Binding BasePriceDisplay}" Width="160"/><DataGridTextColumn Header="تكلفة الوصفة" Binding="{Binding CostDisplay}" Width="160"/></DataGrid.Columns></DataGrid><DataGrid Grid.Row="1" Name="IngredientsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Item_Selected"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding UnitDisplay}" Width="140"/><DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding CostDisplay}" Width="150"/></DataGrid.Columns></DataGrid></Grid><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="9"><TextBlock Text="بيانات المنتج أو الخامة" FontSize="20" FontWeight="Bold"/><TextBox Name="ItemName" PlaceholderText="الاسم، مثل Chocolate Cake أو Flour"/><TextBlock Text="وحدة التخزين: g للوزن، ml للسوائل، قطعة للعدد" TextWrapping="Wrap"/><TextBox Name="ItemUnit" Text="قطعة" PlaceholderText="g / ml / قطعة"/><TextBlock Text="دقة الوحدة"/><TextBox Name="ItemScale" Text="1"/><ComboBox Name="ItemKind" SelectedIndex="0"><ComboBoxItem Content="منتج" Tag="PRODUCT"/><ComboBoxItem Content="خامة" Tag="INGREDIENT"/></ComboBox><TextBlock Text="سعر البيع الأساسي للمنتج (ج.م)"/><TextBox Name="ItemBasePrice" Text="0" PlaceholderText="مثال 500"/><TextBlock Classes="muted" Text="الفروع تستطيع اختيار سعر بيع مستقل. لا تحتاج إلى كتابة كود أو رقم للصنف." TextWrapping="Wrap"/><Button Classes="primary" Content="حفظ ومزامنة" Click="SaveItem_Click"/></StackPanel></Border></Grid></Grid></TabItem>
      <TabItem Header="الإعدادات"><StackPanel Spacing="10" MaxWidth="760" Margin="18"><TextBlock Classes="screen-title" Text="الإعدادات"/><TextBlock Text="Excel ومجلد التقارير" FontWeight="Bold"/><TextBox Name="ReportsDirectory" IsReadOnly="True"/><Button Content="تغيير المجلد..." Click="ReportsFolder_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="طابعة الإيصالات" FontWeight="Bold"/><ComboBox Name="PrinterName" PlaceholderText="اختر طابعة حرارية"/><Button Content="اختبار الطابعة" Click="PrinterTest_Click" HorizontalAlignment="Left"/><StackPanel Name="EnrollmentPanel" Spacing="8"><Separator/><TextBlock Text="إعداد الجهاز لأول مرة فقط" FontSize="18" FontWeight="Bold"/><TextBlock Text="بعد الربط الأول يتصل المطبخ بالخادم ويزامن تلقائياً عند كل تشغيل." TextWrapping="Wrap"/><TextBox Name="ApiUrl" Text="https://ascendyz.xyz/api/v1"/><TextBox Name="EnrollmentToken" PlaceholderText="رمز التسجيل لمرة واحدة"/><TextBox Name="DeviceName" PlaceholderText="اسم الجهاز"/><Button Classes="primary" Content="ربط الجهاز" Click="Enroll_Click"/></StackPanel></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
