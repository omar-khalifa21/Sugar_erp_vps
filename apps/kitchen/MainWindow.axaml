<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SugarERP.Kitchen.App.MainWindow" Title="Sugar ERP — المطبخ" Width="1280" Height="800" MinWidth="1000" MinHeight="680" FlowDirection="RightToLeft" Background="#F7F8FC">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,9"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#75264A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.home-card"><Setter Property="MinHeight" Value="132"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5D9E0"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="TextBlock.screen-title"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#202333"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#747B8F"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="#75264A" Padding="18,14"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Button Name="HomeButton" Content="⌂ الرئيسية" Click="Home_Click" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="Sugar ERP · المطبخ" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="المخزون والوصفات وطلبات الفروع" Foreground="#FFD9E8"/></StackPanel><Button Grid.Column="2" Name="UpdateButton" Content="التحديثات" Click="Update_Click" Margin="4"/><Button Grid.Column="3" Name="SyncButton" Content="مزامنة الآن" Click="Sync_Click" Margin="4"/></Grid></Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4E6EF" BorderThickness="0,0,0,1" Padding="14,9"><Grid ColumnDefinitions="Auto,*"><Border Name="SyncBadge" Background="#E9F8EF" CornerRadius="999" Padding="12,6"><TextBlock Name="SyncStateText" Text="متزامن" Foreground="#237A49" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Name="StatusText" Margin="14,4" FontSize="14" TextWrapping="Wrap" Foreground="#5E6578"/></Grid></Border>
    <TabControl Grid.Row="2" Name="MainTabs" Margin="14" TabStripPlacement="Top">
      <TabItem Header="الرئيسية"><ScrollViewer><StackPanel Spacing="18" Margin="4"><StackPanel><TextBlock Classes="screen-title" Text="لوحة المطبخ"/><TextBlock Classes="muted" Text="اختر الوحدة التي تريد العمل عليها. تتم المزامنة تلقائياً في الخلفية."/></StackPanel><UniformGrid Columns="4" Rows="1">
        <Button Classes="home-card" Click="OpenStock_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="المخزون" FontSize="22" FontWeight="Bold"/><TextBlock Text="استلام خامات، هالك، وجرد" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeLowStock" Text="—" Foreground="#B54708"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenRecipes_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="الوصفات" FontSize="22" FontWeight="Bold"/><TextBlock Text="وصفات المنتجات واستهلاك الخامات" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRecipes" Text="—"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenRequests_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="الوارد" FontSize="22" FontWeight="Bold"/><TextBlock Text="طلبات الفروع والتجهيز والإرسال" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRequests" Text="—" Foreground="#75264A"/></StackPanel></Button>
        <Button Classes="home-card" Click="OpenOrders_Click" Margin="6"><StackPanel Spacing="9"><TextBlock Text="طلبات الكافيهات" FontSize="22" FontWeight="Bold"/><TextBlock Text="إنشاء وطباعة الطلبات الخاصة" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeOrders" Text="—"/></StackPanel></Button>
      </UniformGrid><Grid ColumnDefinitions="2*,*" ColumnSpacing="14"><Border Classes="panel"><StackPanel Spacing="10"><TextBlock Text="ملخص التشغيل" FontSize="18" FontWeight="Bold"/><Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Name="PendingSyncCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="بانتظار المزامنة" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Name="IngredientCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="خامات مسجلة" Classes="muted"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Name="PendingRequestCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="طلبات قيد التنفيذ" Classes="muted"/></StackPanel></Grid></StackPanel></Border><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="حالة الخادم" FontSize="18" FontWeight="Bold"/><TextBlock Name="ServerStatusText" Text="سيتم الفحص تلقائياً" Classes="muted" TextWrapping="Wrap"/><Button Content="فتح الإعدادات" Click="OpenSettings_Click"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="طلبات الفروع"><Grid RowDefinitions="Auto,*"><StackPanel Margin="8" Spacing="4"><TextBlock Classes="screen-title" Text="طلبات الفروع"/><TextBlock Classes="muted" Text="الطلبات الجديدة تظهر تلقائياً من الخادم."/></StackPanel><ListBox Grid.Row="1" Name="RequestsList" SelectionChanged="Request_Selected"><ListBox.ItemTemplate><DataTemplate><Border Classes="panel" Padding="14" Margin="3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding BranchName}" FontWeight="Bold" FontSize="17"/><TextBlock Text="{Binding SubmittedAtUtc}" Classes="muted"/></StackPanel><Border Grid.Column="1" Background="#F3EAF0" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding Status}" Foreground="#75264A" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="تجهيز وإرسال"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="8"><TextBlock Name="SelectedTitle" Classes="screen-title" Text="تجهيز وإرسال"/><TextBlock Classes="muted" Text="حدد الكمية الفعلية؛ تُخصم الوصفة مرة واحدة عند تأكيد الشحنة."/></StackPanel><DataGrid Grid.Row="1" Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="المطلوب" Binding="{Binding RequestedDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="تم إرساله" Binding="{Binding SentDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="إرسال الآن" Binding="{Binding SendDisplay}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Classes="primary" Content="تأكيد الشحنة وإرسالها" HorizontalAlignment="Right" MinWidth="260" Margin="8" Click="Dispatch_Click"/></Grid></TabItem>
      <TabItem Header="الاستلام والخلافات"><Grid RowDefinitions="Auto,*,Auto,*"><TextBlock Classes="screen-title" Text="الاستلام والخلافات" Margin="8"/><DataGrid Grid.Row="1" Name="ReceiptsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الشحنة" Binding="{Binding ShipmentId}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchSiteId}" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="140"/><DataGridTextColumn Header="وقت العد" Binding="{Binding CountedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="مرتجعات الفروع إلى المطبخ" FontWeight="Bold" FontSize="17" Margin="8"/><DataGrid Grid.Row="3" Name="ReturnsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchSiteId}" Width="*"/><DataGridTextColumn Header="وقت الإرسال" Binding="{Binding DispatchedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="المخزون"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="8" Spacing="6"><TextBlock Classes="screen-title" Text="مخزون الخامات"/><TextBlock Classes="muted" Text="الحالي هو الرصيد المسجل؛ المتوقع يخصم التزامات الطلبات غير المرسلة ذات الوصفات المعتمدة."/><TextBox Name="InventoryReason" PlaceholderText="سبب الاستلام أو الهالك (إلزامي)"/></StackPanel><DataGrid Grid.Row="1" Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الحالي" Binding="{Binding CurrentDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="المتوقع" Binding="{Binding ExpectedDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="الحالة" Binding="{Binding StockStatus}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="كمية العملية / العد" Binding="{Binding InputDisplay}" Width="210"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="8"><Button Grid.Column="0" Classes="primary" Content="إضافة مخزون" Click="ReceiveIngredients_Click" Margin="4"/><Button Grid.Column="1" Content="هالك / إتلاف" Click="WasteIngredients_Click" Margin="4"/><Button Grid.Column="2" Content="إقفال جرد اليوم" Click="CountIngredients_Click" Margin="4"/></Grid></Grid></TabItem>
      <TabItem Header="الوصفات"><Grid RowDefinitions="Auto,*" Margin="8"><StackPanel Spacing="5"><TextBlock Classes="screen-title" Text="الوصفات"/><TextBlock Classes="muted" Text="الوصفات المنشورة من لوحة الإدارة؛ يستخدم الإرسال النسخة المعتمدة المحفوظة."/><TextBox Name="RecipeSearch" PlaceholderText="بحث باسم المنتج" TextChanged="RecipeSearch_Changed"/></StackPanel><DataGrid Grid.Row="1" Name="RecipesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="الناتج" Binding="{Binding OutputDisplay}" Width="160"/><DataGridTextColumn Header="المكونات" Binding="{Binding ComponentsDisplay}" Width="2*"/><DataGridTextColumn Header="الإصدار" Binding="{Binding Version}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="الطلبات الخاصة"><Grid RowDefinitions="Auto,*,Auto,*,Auto" ColumnDefinitions="*,*" Margin="8"><StackPanel Grid.ColumnSpan="2" Spacing="6"><TextBlock Classes="screen-title" Text="طلبات الكافيهات والسوبر ماركت"/><TextBlock Classes="muted" Text="تُحفظ الفاتورة محلياً أولاً ثم تُرسل للخادم دون تكرار."/><ComboBox Name="CafeCustomer" PlaceholderText="اختر العميل" SelectionChanged="CafeCustomer_Selected"/><Button Content="إخفاء الكافيه المحدد" Click="DeleteCafeCustomer_Click" HorizontalAlignment="Right"/><TextBox Name="CustomDue" PlaceholderText="موعد التسليم: 2026-09-21 18:30"/><TextBox Name="CustomDescription" PlaceholderText="ملاحظات الطلب"/></StackPanel><DataGrid Grid.Row="1" Grid.ColumnSpan="2" Name="CafeItemsGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="السعر" Binding="{Binding PriceDisplay}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Grid.ColumnSpan="2" Classes="primary" Content="حفظ الفاتورة وإرسالها" Click="CreateCustomOrder_Click" Margin="4"/><DataGrid Grid.Row="3" Grid.ColumnSpan="2" Name="CustomOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الفاتورة" Binding="{Binding OrderNumber}" Width="180"/><DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="التسليم" Binding="{Binding DueDisplay}" Width="200"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="150"/></DataGrid.Columns></DataGrid><Button Grid.Row="4" Grid.ColumnSpan="2" Content="طباعة / إعادة طباعة الفاتورة المحددة" Click="PrintCustomOrder_Click" Margin="4"/></Grid></TabItem>
      <TabItem Header="الإعدادات"><StackPanel Spacing="10" MaxWidth="760" Margin="18"><TextBlock Classes="screen-title" Text="الإعدادات"/><TextBlock Text="Excel ومجلد التقارير" FontWeight="Bold"/><TextBox Name="ReportsDirectory" IsReadOnly="True"/><Button Content="تغيير المجلد..." Click="ReportsFolder_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="طابعة الإيصالات" FontWeight="Bold"/><ComboBox Name="PrinterName" PlaceholderText="اختر طابعة حرارية"/><Button Content="اختبار الطابعة" Click="PrinterTest_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="ربط هذا الجهاز بموقع مطبخ" FontSize="18" FontWeight="Bold"/><TextBlock Text="أنشئ رمز تسجيل لموقع من نوع مطبخ من لوحة الإدارة." TextWrapping="Wrap"/><TextBox Name="ApiUrl" Text="https://ascendyz.xyz/api/v1"/><TextBox Name="EnrollmentToken" PlaceholderText="رمز التسجيل لمرة واحدة"/><TextBox Name="DeviceName" PlaceholderText="اسم الجهاز"/><Button Classes="primary" Content="ربط الجهاز" Click="Enroll_Click"/></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
