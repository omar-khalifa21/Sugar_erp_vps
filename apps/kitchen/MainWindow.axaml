<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SugarERP.Kitchen.App.MainWindow" Title="Sugar ERP — المطبخ" Width="1280" Height="800" MinWidth="1000" MinHeight="680" FlowDirection="RightToLeft" Background="#F7F8FC">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="17,9"/><Setter Property="CornerRadius" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#8B2D5D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="#FBEAF2"/><Setter Property="Foreground" Value="#75264A"/><Setter Property="BorderBrush" Value="#E7B9CE"/></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#FFF1F0"/><Setter Property="Foreground" Value="#B42318"/><Setter Property="BorderBrush" Value="#FDA29B"/></Style>
    <Style Selector="Button.home-card"><Setter Property="MinHeight" Value="148"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E8D7E0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Button.home-card:pointerover"><Setter Property="Background" Value="#FFF7FA"/><Setter Property="BorderBrush" Value="#C76A92"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="Border.soft"><Setter Property="Background" Value="#FFF7FA"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/></Style>
    <Style Selector="TextBlock.screen-title"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#202333"/></Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#302A32"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#747B8F"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="42"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style Selector="ListBoxItem:selected Border.soft"><Setter Property="Background" Value="#F7D8E6"/><Setter Property="BorderBrush" Value="#8B2D5D"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="ListBoxItem:pointerover Border.soft"><Setter Property="Background" Value="#FCE8F1"/></Style>
    <Style Selector="TabControl.workspace TabItem"><Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="#75264A" Padding="20,14"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Button Name="HomeButton" Content="⌂ الرئيسية" Click="Home_Click" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="Sugar ERP · المطبخ" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="الخامات والإنتاج وحسابات الكافيهات" Foreground="#FFD9E8"/></StackPanel><Button Grid.Column="2" Name="UpdateButton" Content="التحديثات" Click="Update_Click" Margin="4"/><Button Grid.Column="3" Name="SyncButton" Content="تحديث يدوي" Click="Sync_Click" Margin="4"/></Grid></Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#E4E6EF" BorderThickness="0,0,0,1" Padding="14,9"><Grid ColumnDefinitions="Auto,*"><Border Name="SyncBadge" Background="#E9F8EF" CornerRadius="999" Padding="12,6"><TextBlock Name="SyncStateText" Text="متزامن" Foreground="#237A49" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Name="StatusText" Margin="14,4" FontSize="14" TextWrapping="Wrap" Foreground="#5E6578"/></Grid></Border>
    <TabControl Grid.Row="2" Name="MainTabs" Classes="workspace" Margin="18">
      <TabItem Header="الرئيسية"><ScrollViewer><StackPanel Spacing="18" Margin="4"><StackPanel><TextBlock Classes="screen-title" Text="لوحة المطبخ"/><TextBlock Classes="muted" Text="كل أعمال المطبخ من مكان واحد. لا توجد ورديات أو رصيد افتتاحي في المطبخ."/></StackPanel><UniformGrid Columns="3" Rows="2"><Button Classes="home-card" Click="OpenStock_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="الخامات" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="تعريف الخامات، المشتريات، الرصيد والتكلفة" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeLowStock" Text="—" Foreground="#B54708"/></StackPanel></Button><Button Classes="home-card" Click="OpenRecipes_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="الوصفات" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="وصفات المنتجات واستهلاك الخامات" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRecipes" Text="—"/></StackPanel></Button><Button Classes="home-card" Click="OpenRequests_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="الوارد" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="طلبات الفروع والتجهيز والإرسال" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeRequests" Text="—"/></StackPanel></Button><Button Classes="home-card" Click="OpenOrders_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="الكافيهات" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="حسابات العملاء والطلبات الخارجة من المطبخ" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeOrders" Text="—"/></StackPanel></Button><Button Classes="home-card" Click="OpenItems_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="المنتجات" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="الأصناف النهائية التي يبيعها أو يرسلها Sugar" TextWrapping="Wrap" Classes="muted"/><TextBlock Name="HomeItems" Text="—"/></StackPanel></Button><Button Classes="home-card" Click="OpenSettings_Click" Margin="7"><StackPanel Spacing="10"><TextBlock Text="الإعدادات" FontSize="24" FontWeight="Bold" Foreground="#75264A"/><TextBlock Text="الطابعة والتقارير وربط الجهاز" TextWrapping="Wrap" Classes="muted"/><TextBlock Text="فتح الإعدادات ←"/></StackPanel></Button></UniformGrid><Grid ColumnDefinitions="2*,*" ColumnSpacing="14"><Border Classes="panel"><StackPanel Spacing="10"><TextBlock Text="ملخص التشغيل" Classes="section-title"/><Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Name="PendingSyncCount" Text="0" FontSize="29" FontWeight="Bold"/><TextBlock Text="بانتظار المزامنة" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Name="IngredientCount" Text="0" FontSize="29" FontWeight="Bold"/><TextBlock Text="خامات مسجلة" Classes="muted"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Name="PendingRequestCount" Text="0" FontSize="29" FontWeight="Bold"/><TextBlock Text="طلبات قيد التنفيذ" Classes="muted"/></StackPanel></Grid></StackPanel></Border><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="حالة الخادم" Classes="section-title"/><TextBlock Name="ServerStatusText" Text="سيتم الفحص تلقائياً" Classes="muted" TextWrapping="Wrap"/><Button Content="فتح الإعدادات" Click="OpenSettings_Click"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="الوارد"><Grid RowDefinitions="Auto,*" Margin="6"><StackPanel Spacing="8"><TextBlock Classes="screen-title" Text="وارد الفروع"/><TextBlock Classes="muted" Text="تظهر الطلبات وتتغير حالتها تلقائياً بدون زر مزامنة."/><WrapPanel><Button Name="PendingFilter" Content="Pending · قيد الانتظار" Click="PendingFilter_Click" Margin="3"/><Button Name="SentFilter" Content="Sent · تم الإرسال" Click="SentFilter_Click" Margin="3"/><Button Name="ConfirmedFilter" Content="Confirmed · مؤكد" Click="ConfirmedFilter_Click" Margin="3"/><Button Name="ConflictedFilter" Content="Conflicted · مختلف" Click="ConflictedFilter_Click" Margin="3"/></WrapPanel></StackPanel><Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12"><ListBox Name="RequestsList" SelectionChanged="Request_Selected"><ListBox.ItemTemplate><DataTemplate><Border Classes="panel" Padding="14"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding BranchName}" FontWeight="Bold" FontSize="18"/><Border Grid.Column="1" Background="#F3EAF0" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding Status}" Foreground="#75264A" FontWeight="Bold"/></Border></Grid><TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/><TextBlock Text="{Binding SubmittedDisplay}" Classes="muted"/><TextBlock Text="{Binding ItemCountDisplay}" Classes="muted"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Classes="panel"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Spacing="5"><TextBlock Name="SelectedTitle" Classes="screen-title" Text="اختر طلباً"/><TextBlock Name="SelectedSubtitle" Classes="muted" Text="افتح الطلب لمراجعة الكميات."/></StackPanel><DataGrid Grid.Row="1" Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="المطلوب" Binding="{Binding RequestedDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="الكمية المرسلة" Binding="{Binding SendDisplay}" Width="180"/><DataGridTextColumn Header="التغيير" Binding="{Binding ChangeDisplay}" Width="180" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Name="DispatchButton" Classes="primary" Content="Confirm &amp; Send · تأكيد وإرسال" HorizontalAlignment="Right" MinWidth="300" Margin="8" Click="Dispatch_Click" IsVisible="False"/></Grid></Border></Grid></Grid></TabItem>
      <TabItem Header="الخامات"><Grid RowDefinitions="Auto,*" Margin="4"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14"><StackPanel><TextBlock Classes="screen-title" Text="الخامات"/><TextBlock Classes="muted" Text="تعريف المواد الخام منفصل عن رصيد المخزون. تغييرات الرصيد تتم بحركات شراء أو استهلاك فقط."/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button Classes="primary" Content="+ إضافة مشتريات" Click="AddPurchase_Click" Margin="4"/><Button Classes="secondary" Content="+ إضافة خامة" Click="AddIngredient_Click" Margin="4"/></WrapPanel></Grid><Grid Grid.Row="1" RowDefinitions="Auto,*"><Border Background="#F1E8ED" CornerRadius="12" Padding="5" HorizontalAlignment="Right" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Name="IngredientCatalogToggle" Classes="primary" Content="الخامات" Click="ShowIngredientCatalog_Click" MinWidth="135"/><Button Name="IngredientStockToggle" Content="المخزون" Click="ShowIngredientStock_Click" MinWidth="135"/></StackPanel></Border><Grid Grid.Row="1"><Grid Name="IngredientCatalogPanel" ColumnDefinitions="2*,*" ColumnSpacing="14"><Border Classes="panel"><Grid RowDefinitions="Auto,*"><TextBlock Text="دليل الخامات" Classes="section-title" Margin="0,0,0,12"/><ListBox Grid.Row="1" Name="IngredientCatalogList" SelectionChanged="Item_Selected"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding UnitDisplay}" Classes="muted"/><TextBlock Text="{Binding StockDisplay}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="متوسط التكلفة" Classes="muted"/><TextBlock Text="{Binding CostDisplay}" FontSize="18" FontWeight="Bold" Foreground="#75264A"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="10"><TextBlock Text="بيانات الخامة" Classes="section-title"/><TextBlock Classes="muted" Text="اختر خامة من القائمة لتعديل الاسم أو الوحدة. الرصيد لا يُعدّل من هنا." TextWrapping="Wrap"/><TextBox Name="ItemName" PlaceholderText="اسم الخامة"/><ComboBox Name="ItemUnit" PlaceholderText="الوحدة"><ComboBoxItem Content="قطعة"/><ComboBoxItem Content="g"/><ComboBoxItem Content="kg"/><ComboBoxItem Content="ml"/><ComboBoxItem Content="L"/></ComboBox><TextBlock Name="IngredientPricingHint" Text="التكلفة الحالية: —"/><Button Classes="primary" Content="حفظ بيانات الخامة" Click="SaveIngredientMetadata_Click"/><Button Classes="danger" Content="حذف نهائي لخامة لم تُزامن" Click="PermanentlyDeleteItem_Click"/><TextBlock Classes="muted" Text="الخامة المستخدمة في وصفة أو حركة مخزون لا يمكن حذفها." TextWrapping="Wrap"/></StackPanel></Border></Grid><Grid Name="IngredientStockPanel" IsVisible="False" RowDefinitions="*,Auto"><Border Classes="panel"><Grid RowDefinitions="Auto,*"><TextBlock Text="الرصيد الحالي" Classes="section-title" Margin="0,0,0,12"/><ListBox Grid.Row="1" Name="InventoryCards"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding AverageCostDisplay}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="المتاح" Classes="muted"/><TextBlock Text="{Binding CurrentDisplay}" FontSize="20" FontWeight="Bold"/></StackPanel><Border Grid.Column="2" Background="#E9F8EF" CornerRadius="999" Padding="12,7"><TextBlock Text="{Binding StockStatus}" Foreground="#237A49" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Expander Grid.Row="1" Header="الجرد والهالك" Margin="0,12,0,0"><Border Classes="panel"><Grid RowDefinitions="Auto,*,Auto"><TextBox Name="InventoryReason" Text="هالك خامات" PlaceholderText="سبب الهالك أو الجرد"/><DataGrid Grid.Row="1" Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="False" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الحالي" Binding="{Binding CurrentDisplay}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding InputDisplay}" Width="190"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" HorizontalAlignment="Left"><Button Content="تسجيل هالك" Click="WasteIngredients_Click" Margin="4"/><Button Content="إقفال جرد اليوم" Click="CountIngredients_Click" Margin="4"/></WrapPanel></Grid></Border></Expander></Grid></Grid></Grid></Grid></TabItem>
      <TabItem Header="الوصفات">
        <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="14" Background="#FFF4F8">
          <Border Classes="panel" Background="#FFF9FC"><StackPanel Spacing="10">
            <TextBlock Classes="screen-title" Text="وصفات المنتجات" Foreground="#75264A"/>
            <TextBlock Classes="muted" Text="اختر منتجاً لتحميل وصفته وتعديلها. وحدات الخامات وتكلفتها تُقرأ تلقائياً من دليل الخامات."/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="المنتج" FontWeight="Bold"/><ComboBox Name="RecipeProduct" MinWidth="320" PlaceholderText="ابحث واختر المنتج" IsTextSearchEnabled="True" SelectionChanged="RecipeProduct_Selected"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="كمية ناتج الوصفة" FontWeight="Bold"/><TextBox Name="RecipeOutput" Width="170" Text="1"/></StackPanel></Grid>
            <Border Classes="soft"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10"><ComboBox Name="RecipeIngredient" PlaceholderText="ابحث واختر الخامة" IsTextSearchEnabled="True"/><TextBox Grid.Column="1" Name="RecipeQuantity" Width="130" PlaceholderText="الكمية"/><ComboBox Grid.Column="2" Name="RecipeUnit" Width="1" IsVisible="False"/><Button Grid.Column="3" Classes="primary" Content="+ أضف للوصفة" Click="AddRecipeIngredient_Click"/></Grid></Border>
          </StackPanel></Border>
          <Border Grid.Row="1" Classes="panel"><DataGrid Name="RecipeComponentsGrid" AutoGenerateColumns="False" CellEditEnded="RecipeComponentEdited"><DataGrid.Columns><DataGridTextColumn Header="الخامة" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="220"/><DataGridTextColumn Header="التكلفة الحالية" Binding="{Binding CostDisplay}" Width="190" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Border>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><WrapPanel><Button Content="حذف المكون المحدد" Click="RemoveRecipeIngredient_Click" Margin="4"/><Button Classes="primary" Content="حفظ الوصفة ومزامنتها" Click="SaveRecipe_Click" Margin="4"/></WrapPanel><Border Grid.Column="2" Background="#75264A" CornerRadius="14" Padding="24,12"><StackPanel><TextBlock Text="إجمالي تكلفة الوصفة" Foreground="#FFD9E8" FontWeight="Bold"/><TextBlock Name="RecipeCost" Text="0.00 ج.م" Foreground="White" FontSize="27" FontWeight="Bold"/></StackPanel></Border></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="الكافيهات">
        <Grid RowDefinitions="Auto,*" Margin="4" Background="#FFF4F8">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><StackPanel><TextBlock Classes="screen-title" Text="حسابات الكافيهات" Foreground="#75264A"/><TextBlock Classes="muted" Text="اختر الحساب، أضف المنتجات للطلب الحالي، راجع الإجمالي ثم احفظ أو سلّم واطبع."/></StackPanel><Button Grid.Column="1" Classes="primary" Content="+ إضافة كافيه" Click="NewCafe_Click" MinWidth="170"/></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="12">
            <Border Classes="panel"><Grid RowDefinitions="Auto,*"><TextBlock Text="العملاء" Classes="section-title"/><ListBox Grid.Row="1" Name="CafeCustomer" SelectionChanged="CafeCustomer_Selected" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Contact}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding BalanceDisplay}" Foreground="#8B2D5D" FontWeight="Bold"/><TextBlock Text="{Binding OrdersDisplay}" Classes="muted"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
              <Border Classes="panel"><Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="9"><TextBox Name="CafeName" PlaceholderText="اسم الكافيه"/><TextBox Grid.Column="1" Name="CafeContact" PlaceholderText="رقم الاتصال"/><WrapPanel Grid.Column="2"><Button Classes="primary" Content="حفظ الحساب والأسعار" Click="SaveCafe_Click" Margin="3"/><Button Content="أرشفة" Click="ArchiveCafeCustomer_Click" Margin="3"/></WrapPanel></Grid></Border>
              <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.35*" ColumnSpacing="10">
                <Grid RowDefinitions="1.1*,*" RowSpacing="10">
                  <Border Classes="panel"><Grid RowDefinitions="Auto,*"><StackPanel><TextBlock Text="المنتجات" Classes="section-title"/><TextBox Name="CafeProductSearch" PlaceholderText="بحث عن منتج..." TextChanged="CafeProductSearch_Changed" Margin="0,7"/></StackPanel><ListBox Grid.Row="1" Name="CafeProductList" SelectionChanged="CafeProduct_Selected"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Unit}" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" Foreground="#8B2D5D" FontWeight="Bold"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                  <Border Grid.Row="1" Classes="panel"><Grid RowDefinitions="Auto,*"><TextBlock Text="الفواتير السابقة والمفتوحة" Classes="section-title"/><DataGrid Grid.Row="1" Name="CustomOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,7"><DataGrid.Columns><DataGridTextColumn Header="الفاتورة" Binding="{Binding OrderNumber}" Width="*"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="120"/><DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="110"/></DataGrid.Columns></DataGrid></Grid></Border>
                </Grid>
                <Border Grid.Column="1" Classes="panel"><Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="9"><TextBlock Text="الطلب الحالي" Classes="section-title"/><Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox Name="CustomDue" PlaceholderText="موعد التسليم: 2026-09-25 18:30"/><TextBox Grid.Column="1" Name="CustomDescription" PlaceholderText="ملاحظات الطلب"/></Grid><DataGrid Grid.Row="2" Name="CafeItemsGrid" AutoGenerateColumns="False" CellEditEnded="CafeOrderLineEdited"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="100"/><DataGridTextColumn Header="سعر الكافيه" Binding="{Binding PriceDisplay}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotalDisplay}" Width="130" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10"><Button Content="حذف المنتج المحدد" Click="RemoveCafeOrderLine_Click"/><Border Grid.Column="1" Background="#75264A" CornerRadius="13" Padding="18,9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="إجمالي الطلب" Foreground="#FFD9E8" FontWeight="Bold"/><TextBlock Grid.Column="1" Name="CafeOrderTotal" Text="0.00 ج.م" Foreground="White" FontSize="24" FontWeight="Bold"/></Grid></Border></Grid><WrapPanel Grid.Row="4" HorizontalAlignment="Left"><Button Classes="primary" Content="حفظ الطلب" Click="CreateCustomOrder_Click" Margin="3"/><Button Classes="primary" Content="تأكيد التسليم وخصم الخامات" Click="DeliverCafeOrder_Click" Margin="3"/><Button Content="طباعة الفاتورة" Click="PrintCustomOrder_Click" Margin="3"/></WrapPanel></Grid></Border>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="المنتجات"><Grid RowDefinitions="Auto,*" Margin="8" Background="#FFF4F8"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><StackPanel><TextBlock Classes="screen-title" Text="المنتجات النهائية" Foreground="#75264A"/><TextBlock Classes="muted" Text="التكلفة والربح محسوبان من الوصفة وأسعار الخامات الحالية. أسعار الكافيه قد تختلف حسب العميل."/></StackPanel><Button Grid.Column="1" Classes="primary" Content="+ منتج جديد" Click="NewProduct_Click"/></Grid><Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12"><DataGrid Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Item_Selected"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="التكلفة" Binding="{Binding CostDisplay}" Width="140"/><DataGridTextColumn Header="سعر البيع" Binding="{Binding BasePriceDisplay}" Width="140"/><DataGridTextColumn Header="سعر الكافيه" Binding="{Binding CafePriceDisplay}" Width="150"/><DataGridTextColumn Header="الربح" Binding="{Binding ProfitDisplay}" Width="140"/><DataGridTextColumn Header="ربح الكافيه" Binding="{Binding CafeProfitDisplay}" Width="150"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Classes="panel"><StackPanel Spacing="9"><TextBlock Text="بيانات المنتج" Classes="section-title"/><TextBox Name="ProductName" PlaceholderText="اسم المنتج"/><TextBox Name="ProductUnit" Text="قطعة" PlaceholderText="الوحدة"/><TextBox Name="ProductScale" Text="1" PlaceholderText="دقة الوحدة"/><TextBox Name="ItemBasePrice" Text="0" PlaceholderText="سعر البيع العادي بالجنيه"/><TextBlock Classes="muted" Text="سعر الكافيه يُدار لكل عميل من شاشة الكافيهات حتى لا تُمسح الأسعار الخاصة." TextWrapping="Wrap"/><Button Classes="primary" Content="حفظ ومزامنة" Click="SaveProduct_Click"/></StackPanel></Border></Grid></Grid></TabItem>
      <TabItem Header="الإعدادات"><StackPanel Spacing="10" MaxWidth="760" Margin="18"><TextBlock Classes="screen-title" Text="الإعدادات"/><TextBlock Text="Excel ومجلد التقارير" FontWeight="Bold"/><TextBox Name="ReportsDirectory" IsReadOnly="True"/><Button Content="تغيير المجلد..." Click="ReportsFolder_Click" HorizontalAlignment="Left"/><Separator/><TextBlock Text="طابعة الإيصالات" FontWeight="Bold"/><ComboBox Name="PrinterName" PlaceholderText="اختر طابعة حرارية"/><Button Content="اختبار الطابعة" Click="PrinterTest_Click" HorizontalAlignment="Left"/><StackPanel Name="EnrollmentPanel" Spacing="8"><Separator/><TextBlock Text="إعداد الجهاز لأول مرة فقط" FontSize="18" FontWeight="Bold"/><TextBlock Text="بعد الربط الأول يتصل المطبخ بالخادم ويزامن تلقائياً عند كل تشغيل." TextWrapping="Wrap"/><TextBox Name="ApiUrl" Text="https://ascendyz.xyz/api/v1"/><TextBox Name="EnrollmentToken" PlaceholderText="رمز التسجيل لمرة واحدة"/><TextBox Name="DeviceName" PlaceholderText="اسم الجهاز"/><Button Classes="primary" Content="ربط الجهاز" Click="Enroll_Click"/></StackPanel><Separator/><Button Name="ResetConnectionButton" Content="إلغاء ربط الجهاز" Click="ResetConnection_Click" HorizontalAlignment="Left" IsVisible="False"/><TextBlock Classes="muted" Text="إلغاء الربط يحذف بيانات الاتصال فقط، ويحافظ على قاعدة البيانات والفواتير. يُمنع تلقائياً إذا توجد عمليات غير متزامنة." TextWrapping="Wrap"/></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
