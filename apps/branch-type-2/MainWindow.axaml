<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SugarERP.Branch2.App.MainWindow" Title="Sugar ERP — فرع نوع ٢" Width="1280" Height="800" MinWidth="900" MinHeight="640" FlowDirection="RightToLeft">
 <Grid RowDefinitions="Auto,Auto,*" Margin="14">
  <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="فرع نوع ٢ · المخزون والعرض" FontSize="23" FontWeight="Bold"/><Button Grid.Column="1" Name="UpdateButton" Content="Check for Updates" Click="Update_Click" Margin="4"/><Button Grid.Column="2" Content="مزامنة" Click="Sync_Click" Margin="4"/></Grid>
  <TextBlock Grid.Row="1" Name="Status" Margin="0,10" TextWrapping="Wrap"/>
  <TabControl Grid.Row="2">
   <TabItem Header="الأصناف"><Grid ColumnDefinitions="1.2*,*" ColumnSpacing="12" Margin="8"><DataGrid Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Item_Selected"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding NameAr}" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="110"/><DataGridTextColumn Header="السعر" Binding="{Binding Price}" Width="130"/><DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="إضافة أو تعديل صنف" FontSize="20" FontWeight="Bold"/><TextBox Name="ItemName" PlaceholderText="اسم الصنف"/><TextBox Name="ItemUnit" Text="قطعة" PlaceholderText="الوحدة"/><TextBox Name="ItemPrice" PlaceholderText="سعر البيع EGP"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="صنف جديد" Click="NewItem_Click"/><Button Content="حفظ ومزامنة" Click="SaveItem_Click"/><Button Content="أرشفة" Click="ArchiveItem_Click"/></StackPanel><TextBlock Text="الصنف يُحفظ محلياً أولاً ثم يظهر في لوحة الإدارة بعد المزامنة." TextWrapping="Wrap"/></StackPanel></Grid></TabItem>
   <TabItem Header="المخزون والبيع"><Grid RowDefinitions="*,Auto,Auto"><DataGrid Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="140"/><DataGridTextColumn Header="Display" Binding="{Binding Display}" Width="140"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="140"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10"><TextBox Name="Quantity" Text="1" Width="120" PlaceholderText="الكمية"/><TextBox Name="Reason" Width="260" PlaceholderText="السبب"/><Button Content="Stock → Display" Click="Move_Click"/><Button Content="بيع من Display" Click="Sell_Click"/><Button Content="طلب وارد" Click="Request_Click"/><Button Content="مرتجع للمطبخ" Click="Return_Click"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="بدء وردية" Click="OpenShift_Click"/><Button Content="إنهاء اليوم: Display → Stock" Click="EndDay_Click"/><TextBlock Text="الحركات المحلية تبقى محفوظة في سجل المعاملات وقائمة المزامنة." VerticalAlignment="Center"/></StackPanel></Grid></TabItem>
   <TabItem Header="الوارد"><Grid RowDefinitions="Auto,*,Auto,Auto"><ComboBox Name="Shipments" SelectionChanged="Shipment_Selected"/><DataGrid Grid.Row="1" Name="ReceiptGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="المرسل" Binding="{Binding Sent}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="العد الفعلي" Binding="{Binding Counted}" Width="150"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="تسجيل العد والاستلام" Click="Receive_Click"/><Button Grid.Row="3" Content="إضافة الصنف والكمية المحددين كوارد يدوي بدون طلب" Click="ManualIncoming_Click" Margin="0,10,0,0"/></Grid></TabItem>
   <TabItem Header="الطلبات الخاصة"><Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8"><Grid ColumnDefinitions="*,Auto"><ComboBox Name="Cafes" PlaceholderText="اختر العميل"/><Button Grid.Column="1" Content="حذف الكافيه" Click="CafeArchive_Click" Margin="8,0,0,0"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10"><TextBlock Text="اختر الصنف والكمية من صفحة المخزون أولاً." VerticalAlignment="Center"/><Button Content="إنشاء طلب للعميل" Click="CafeCreate_Click"/></StackPanel><DataGrid Grid.Row="2" Name="CafeOrders" AutoGenerateColumns="True" IsReadOnly="True"/><StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><Button Content="تسليم الطلب المحدد من Stock" Click="CafeDeliver_Click"/><TextBox Name="CafePaymentAmount" Width="140" PlaceholderText="المبلغ EGP"/><ComboBox Name="CafePaymentMethod" SelectedIndex="0"><ComboBoxItem Content="نقدي"/><ComboBoxItem Content="Visa"/></ComboBox><Button Content="تسجيل دفعة" Click="CafePayment_Click"/></StackPanel></Grid></TabItem>
   <TabItem Header="سجل المخزون"><DataGrid Name="History" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem>
   <TabItem Header="الدخول والإعدادات"><StackPanel MaxWidth="700" Spacing="10" Margin="16"><TextBlock Text="تسجيل دخول المستخدم" FontWeight="Bold"/><TextBox Name="Username" PlaceholderText="اسم المستخدم"/><TextBox Name="Password" PasswordChar="●" PlaceholderText="كلمة المرور"/><Button Content="تسجيل الدخول" Click="Login_Click"/><Separator/><TextBlock Text="ربط الجهاز لأول مرة"/><TextBox Name="ApiUrl" Text="https://ascendyz.xyz/api/v1"/><TextBox Name="Enrollment" PlaceholderText="رمز التسجيل لفرع نوع ٢"/><Button Content="ربط الجهاز" Click="Enroll_Click"/><Separator/><TextBlock Text="Excel / Reports Location"/><TextBox Name="ReportsDirectory" IsReadOnly="True"/><Button Content="تغيير مجلد التقارير..." Click="Reports_Click"/></StackPanel></TabItem>
  </TabControl>
 </Grid>
</Window>
