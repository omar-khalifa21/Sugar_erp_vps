generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteType {
  BRANCH_TYPE_1
  BRANCH_TYPE_2
  KITCHEN
}

enum DeviceProfile {
  BRANCH_TYPE_1
  BRANCH_TYPE_2
  KITCHEN
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  REVOKED
}

enum ItemKind {
  PRODUCT
  INGREDIENT
}

model Site {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique @db.VarChar(50)
  name      String         @db.VarChar(200)
  type      SiteType
  timezone  String         @default("Africa/Cairo") @db.VarChar(100)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  devices   Device[]
  userRoles UserSiteRole[]

  @@map("sites")
}

model Device {
  id               String           @id @default(uuid()) @db.Uuid
  siteId           String           @map("site_id") @db.Uuid
  profile          DeviceProfile
  enrollmentStatus EnrollmentStatus @default(PENDING) @map("enrollment_status")
  keyThumbprint    String?          @unique @map("key_thumbprint") @db.VarChar(128)
  activeWriter     Boolean          @default(false) @map("active_writer")
  lastSeenAt       DateTime?        @map("last_seen_at") @db.Timestamptz(6)
  appVersion       String?          @map("app_version") @db.VarChar(50)
  streamEpoch      Int              @default(1) @map("stream_epoch")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  site             Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@map("devices")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique @db.VarChar(100)
  displayName  String         @map("display_name") @db.VarChar(200)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  siteRoles    UserSiteRole[]

  @@map("users")
}

model Role {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(50)
  name        String         @db.VarChar(100)
  permissions String[]       @default([])
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserSiteRole[]

  @@map("roles")
}

model UserSiteRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  siteId    String?  @map("site_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, siteId, roleId])
  @@index([siteId])
  @@index([roleId])
  @@map("user_site_roles")
}

model Item {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique @db.VarChar(100)
  nameAr        String   @map("name_ar") @db.VarChar(300)
  unit          String   @db.VarChar(30)
  quantityScale Int      @map("quantity_scale")
  kind          ItemKind
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("items")
}
