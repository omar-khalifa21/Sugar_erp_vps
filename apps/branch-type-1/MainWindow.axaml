<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SugarERP.Branch1.MainWindow"
        x:Name="RootWindow"
        Title="Sugar"
        Icon="avares://SugarERP.Branch1/Assets/sugar.ico"
        Width="1440"
        Height="900"
        MinWidth="800"
        MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="#D94F83" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <Image Source="avares://SugarERP.Branch1/Assets/sugar.png" Width="48" Height="48" Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Sugar" FontSize="25" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding SiteName}" Foreground="#FFF0F5" FontSize="14" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0">
          <TextBlock Text="{Binding CurrentPageTitle}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding ShiftLabel}" Foreground="#FFF0F5" FontSize="13" HorizontalAlignment="Left" />
        </StackPanel>
        <Button Grid.Column="2" Name="UpdateButton" Classes="secondary" Content="Check for Updates" Click="Update_Click" Margin="4" />
        <Button Grid.Column="3" Classes="secondary" Content="⌂" ToolTip.Tip="القائمة الرئيسية" Command="{Binding ReturnToMainCommand}" IsVisible="{Binding CanReturnToMain}" MinWidth="54" />
      </Grid>
    </Border>

    <!-- Main module menu -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMenuVisible}">
      <StackPanel Margin="28" Spacing="22" HorizontalAlignment="Center" MaxWidth="1220">
        <StackPanel HorizontalAlignment="Center" Spacing="3">
          <Image Source="avares://SugarERP.Branch1/Assets/sugar.png" Width="140" Height="140" HorizontalAlignment="Center" />
          <TextBlock Classes="title" Text="Sugar" HorizontalAlignment="Center" FontSize="42" />
          <TextBlock Text="{Binding SiteName}" HorizontalAlignment="Center" FontSize="18" Foreground="#806070" />
        </StackPanel>

        <Border Classes="card" IsVisible="{Binding NeedsShift}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="بدء وردية" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
              <TextBlock Text="العهدة الافتتاحية" VerticalAlignment="Center" FontSize="16" />
              <TextBox Width="180" Classes="touch" Text="{Binding OpeningCashText}" PlaceholderText="0.00 ج.م" />
            </StackPanel>
            <WrapPanel ItemWidth="300" ItemHeight="104" HorizontalAlignment="Center">
              <Button Classes="primary" Command="{Binding StartMorningShiftCommand}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="☀" FontSize="35" HorizontalAlignment="Center" /><TextBlock Text="وردية صباحية" FontSize="18" HorizontalAlignment="Center" /></StackPanel></Button>
              <Button Classes="primary" Command="{Binding StartEveningShiftCommand}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="☾" FontSize="35" HorizontalAlignment="Center" /><TextBlock Text="وردية مسائية" FontSize="18" HorizontalAlignment="Center" /></StackPanel></Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <WrapPanel ItemWidth="300" ItemHeight="116" HorizontalAlignment="Center">
          <Button Classes="primary" Command="{Binding ResumeShiftCommand}" IsVisible="{Binding CanResumeShift}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="🛒" FontSize="33" HorizontalAlignment="Center" /><TextBlock Text="نقطة البيع" FontSize="16" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="secondary" Command="{Binding ShowCatalogCommand}" IsEnabled="{Binding IsEnrolled}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="🍰" FontSize="33" HorizontalAlignment="Center" /><TextBlock Text="الأصناف" FontSize="17" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="secondary" Command="{Binding ShowCustomOrdersCommand}" IsEnabled="{Binding IsEnrolled}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="📝" FontSize="33" HorizontalAlignment="Center" /><TextBlock Text="الطلبات الخاصة" FontSize="17" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="secondary" Command="{Binding ShowRequestCommand}" IsEnabled="{Binding IsEnrolled}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="📦" FontSize="33" HorizontalAlignment="Center" /><TextBlock Text="وارد" FontSize="17" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="secondary" Command="{Binding ShowSettingsCommand}" Margin="7"><StackPanel HorizontalAlignment="Center" Spacing="3"><TextBlock Text="⚙" FontSize="33" HorizontalAlignment="Center" /><TextBlock Text="الإعدادات" FontSize="16" HorizontalAlignment="Center" /></StackPanel></Button>
        </WrapPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#806070" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="يمكنك متابعة العمل عند انقطاع الإنترنت بعد ربط الجهاز بالخادم مرة واحدة" Foreground="#806070" HorizontalAlignment="Center" />
      </StackPanel>
    </ScrollViewer>

    <!-- Point of sale -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="12" IsVisible="{Binding IsPosVisible}">
      <Border Grid.Row="0" Classes="card" Padding="14" Margin="0,0,0,12">
        <StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="section" Text="نقطة البيع" /><TextBlock Text="{Binding ShiftLabel}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#806070" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" /></Grid><WrapPanel><Button Classes="primary" Content="البيع" Command="{Binding ResumeShiftCommand}" Margin="3" /><Button Classes="secondary" Content="حركات الوردية" Command="{Binding ShowShiftHistoryCommand}" Margin="3" /><Button Classes="secondary" Content="مرتجع للمطبخ" Command="{Binding ShowReturnCommand}" Margin="3" /><Button Classes="secondary" Content="إغلاق الوردية" Command="{Binding ShowCloseCommand}" Margin="3" /></WrapPanel></StackPanel>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="PosColumns" ColumnDefinitions="2*,3*,2*" ColumnSpacing="12" MinHeight="540">
        <Border x:Name="PosProducts" Grid.Column="0" Classes="card">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Classes="section" Text="الأصناف" />
            <TextBox Grid.Row="1" Text="{Binding SearchText}" PlaceholderText="بحث باسم الصنف" Margin="0,10" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Products}"><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding AddToCartCommand}" HorizontalContentAlignment="Stretch" Margin="2" Padding="12,9"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Grid.Row="1" Text="{Binding AvailabilityLabel}" Classes="caption" /><TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Price}" Foreground="#D94F83" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" /></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
        </Border>
        <Border x:Name="PosCart" Grid.Column="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Classes="section" Text="الطلب الحالي" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" Margin="0,10"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="2*,Auto,Auto,120" Margin="4,7"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding UnitPrice}" Classes="caption" /></StackPanel><Button Grid.Column="1" Content="+" Classes="secondary" Command="{Binding IncreaseCommand}" MinWidth="44" Margin="4,0" Padding="8" /><Button Grid.Column="2" Content="−" Classes="secondary" Command="{Binding DecreaseCommand}" MinWidth="44" Margin="4,0" Padding="8" /><StackPanel Grid.Column="3" HorizontalAlignment="Left"><TextBlock Text="{Binding Quantity}" HorizontalAlignment="Left" /><TextBlock Text="{Binding LineTotal}" FontWeight="Bold" Foreground="#D94F83" HorizontalAlignment="Left" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
        </Border>
        <Border x:Name="PosSummary" Grid.Column="2" Classes="card">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="11">
            <TextBlock Classes="section" Text="ملخص الطلب" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="المجموع" /><TextBlock Grid.Column="1" Text="{Binding SubtotalText}" /></Grid>
            <TextBlock Text="الخصم" /><TextBox Text="{Binding DiscountText}" PlaceholderText="0.00 ج.م" />
            <TextBlock Text="الإكرامية" /><TextBox Text="{Binding TipText}" PlaceholderText="0.00 ج.م" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="الإجمالي" FontWeight="Bold" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" FontSize="19" Foreground="#6D2944" /></Grid>
            <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><RadioButton Content="كاش" GroupName="payment" IsChecked="{Binding IsCash}" /><RadioButton Content="فيزا" GroupName="payment" IsChecked="{Binding IsVisa}" /></StackPanel>
            <TextBlock Text="نوع الطلب" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><RadioButton Content="طاولة" GroupName="fulfillment" IsChecked="{Binding IsTable}" /><RadioButton Content="تيك أواي" GroupName="fulfillment" IsChecked="{Binding IsTakeaway}" /></StackPanel>
            <TextBlock Text="{Binding ValidationMessage}" Classes="error" TextWrapping="Wrap" />
            <Button Classes="primary" Content="تأكيد الطلب" Command="{Binding CompleteSaleCommand}" />
            <Border Background="#E9F8EF" CornerRadius="10" Padding="10" IsVisible="{Binding HasReceipt}"><StackPanel Spacing="3"><TextBlock Text="تم حفظ الطلب بنجاح" Foreground="#18794E" FontWeight="SemiBold" /><TextBlock Text="{Binding ReceiptNumber}" Foreground="#18794E" /><TextBlock Text="{Binding ReceiptTotalText}" Foreground="#18794E" FontWeight="Bold" FontSize="18" /><TextBlock Text="{Binding ReceiptDetails}" Foreground="#18794E" /><Button Classes="secondary" Content="إعادة طباعة الإيصال" Command="{Binding ReprintLastReceiptCommand}" HorizontalAlignment="Stretch" /><Button Content="إغلاق الإيصال" Command="{Binding DismissReceiptCommand}" HorizontalAlignment="Stretch" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Customer profiles, pricing and offline invoices -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsCustomOrdersVisible}">
      <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Classes="title" Text="حسابات الكافيهات والسوبر ماركت" /><Expander Header="الحالة"><TextBlock Text="{Binding CustomOrderStatusText}" Foreground="#6D2944" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander></StackPanel><Button Grid.Column="1" Classes="primary" Content="+ عميل جديد" Command="{Binding NewCafeCommand}" /></Grid></Border>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsCafeProfileListVisible}">
        <Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="اختر حساباً" /><ListBox Grid.Row="1" ItemsSource="{Binding CafeProfiles}" SelectedItem="{Binding SelectedCafe}" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" Classes="caption" /><TextBlock Text="{Binding Phone}" Classes="caption" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="{Binding BalanceText, StringFormat='الرصيد: {0}'}" Foreground="#D94F83" FontWeight="Bold" /><TextBlock Text="{Binding OpenOrdersText}" Classes="caption" HorizontalAlignment="Left" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      </Border>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsCreatingCafe}">
        <ScrollViewer><StackPanel Spacing="10" MaxWidth="720"><TextBlock Classes="section" Text="حساب جديد" /><TextBox Text="{Binding NewCafeName}" PlaceholderText="اسم الكافيه أو السوبر ماركت" /><StackPanel Orientation="Horizontal" Spacing="16"><RadioButton Content="كافيه" GroupName="customer-kind" IsChecked="{Binding NewCustomerIsCafe}" /><RadioButton Content="سوبر ماركت" GroupName="customer-kind" IsChecked="{Binding NewCustomerIsSupermarket}" /></StackPanel><TextBox Text="{Binding NewCafePhone}" PlaceholderText="رقم الهاتف" /><TextBox Text="{Binding NewCafeAddress}" PlaceholderText="العنوان" /><TextBlock Text="نسخ قائمة أسعار من حساب محفوظ" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding CafeProfiles}" SelectedItem="{Binding CafeCopySource}" PlaceholderText="بدون نسخ — استخدم أسعار الفرع"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="النسخة تصبح مستقلة؛ تعديلها لا يغيّر أسعار الحساب الأصلي." Classes="caption" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Classes="secondary" Content="إلغاء" Command="{Binding BackToCafeProfilesCommand}" /><Button Grid.Column="1" Classes="primary" Content="إنشاء الحساب" Command="{Binding CreateCafeCommand}" /></Grid></StackPanel></ScrollViewer>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding HasSelectedCafe}">
        <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Button Classes="secondary" Content="رجوع للحسابات" Command="{Binding BackToCafeProfilesCommand}" /><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Classes="section" Text="{Binding SelectedCafe.Name}" /><TextBlock Text="{Binding SelectedCafe.Kind}" Classes="caption" /></StackPanel><StackPanel Grid.Column="2" Margin="12,0"><TextBlock Text="الرصيد الحالي" Classes="caption" /><TextBlock Text="{Binding CafeBalanceText}" Foreground="#D94F83" FontSize="20" FontWeight="Bold" /></StackPanel><WrapPanel Grid.Column="3"><Button Classes="secondary" Content="الأسعار" Command="{Binding EditCafePricesCommand}" Margin="4" /><Button Classes="primary" Content="+ طلب جديد" Command="{Binding NewCustomOrderCommand}" Margin="4" /></WrapPanel></Grid></Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.15*,*" ColumnSpacing="12" IsVisible="{Binding IsCafeOverviewVisible}">
          <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="الفواتير والطلبات" /><ListBox Grid.Row="1" ItemsSource="{Binding CustomOrderRows}" SelectedItem="{Binding SelectedCustomOrder}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" /><TextBlock Text="{Binding DueText, StringFormat='التسليم: {0}'}" Classes="caption" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalText}" FontWeight="Bold" /><TextBlock Text="{Binding PaymentStatusText}" Foreground="#D94F83" HorizontalAlignment="Left" /></StackPanel><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LinesSummary}" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusText}" Classes="caption" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          <Border Grid.Column="1" Classes="card"><ScrollViewer><StackPanel Spacing="10"><TextBlock Classes="section" Text="تفاصيل الفاتورة" /><TextBlock Text="اختر فاتورة من القائمة." Classes="caption" IsVisible="{Binding !HasSelectedCustomOrder}" /><StackPanel Spacing="9" IsVisible="{Binding HasSelectedCustomOrder}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedCustomOrder.OrderNumber}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding SelectedCustomOrder.StatusText}" Foreground="#D94F83" FontWeight="Bold" /></Grid><TextBlock Text="{Binding SelectedCustomOrder.DueText, StringFormat='موعد التسليم: {0}'}" /><Border Classes="soft"><TextBlock Text="{Binding SelectedCustomOrder.LinesSummary}" TextWrapping="Wrap" /></Border><TextBlock Text="{Binding SelectedCustomOrder.Description}" TextWrapping="Wrap" Classes="caption" /><Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Text="الإجمالي" Classes="caption" /><TextBlock Text="{Binding SelectedCustomOrder.TotalText}" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="المدفوع" Classes="caption" /><TextBlock Text="{Binding SelectedCustomOrder.PaidText}" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="المتبقي" Classes="caption" /><TextBlock Text="{Binding SelectedCustomOrder.RemainingText}" Foreground="#D94F83" FontWeight="Bold" /></StackPanel></Grid><Border Classes="soft"><StackPanel Spacing="7"><TextBlock Text="سداد على الحساب" FontWeight="SemiBold" /><TextBox Text="{Binding CustomOrderPaymentText}" PlaceholderText="المبلغ" /><StackPanel Orientation="Horizontal" Spacing="12"><RadioButton Content="كاش" GroupName="custom-payment" IsChecked="{Binding IsCustomOrderPaymentCash}" /><RadioButton Content="فيزا" GroupName="custom-payment" IsChecked="{Binding IsCustomOrderPaymentVisa}" /></StackPanel><Button Classes="primary" Content="تسجيل السداد" Command="{Binding AddCustomOrderPaymentCommand}" /></StackPanel></Border><WrapPanel><Button Classes="primary" Content="تأكيد" Command="{Binding ConfirmCustomOrderCommand}" IsVisible="{Binding CanConfirmCustomOrder}" Margin="3" /><Button Classes="primary" Content="جاهز" Command="{Binding ReadyCustomOrderCommand}" IsVisible="{Binding CanReadyCustomOrder}" Margin="3" /><Button Classes="primary" Content="تسليم وطباعة الفاتورة" Command="{Binding DeliverCustomOrderCommand}" IsVisible="{Binding CanDeliverCustomOrder}" Margin="3" /><Button Classes="danger" Content="إلغاء" Command="{Binding CancelCustomOrderCommand}" IsVisible="{Binding CanCancelCustomOrder}" Margin="3" /></WrapPanel><Button Classes="secondary" Content="إعادة طباعة الفاتورة" Command="{Binding PrintCustomOrderCommand}" /></StackPanel><Expander Header="إيصالات السداد"><ItemsControl ItemsSource="{Binding CafePaymentRows}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,2"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding AmountText}" FontWeight="Bold" /><TextBlock Text="{Binding DateText}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding MethodText}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></ScrollViewer></Border>
        </Grid>

        <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsEditingCafePrices}"><ScrollViewer><StackPanel Spacing="9"><TextBlock Classes="section" Text="قائمة أسعار هذا العميل" /><TextBlock Text="هذه الأسعار مستقلة ولا تغيّر قائمة أي عميل آخر." Classes="caption" /><ItemsControl ItemsSource="{Binding CafePriceRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,180"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Unit}" Classes="caption" /></StackPanel><TextBox Grid.Column="1" Text="{Binding PriceText}" HorizontalContentAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Classes="secondary" Content="إلغاء" Command="{Binding CancelCafeActionCommand}" /><Button Grid.Column="1" Classes="primary" Content="حفظ الأسعار" Command="{Binding SaveCafePricesCommand}" /></Grid></StackPanel></ScrollViewer></Border>

        <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsCreatingCustomOrder}"><ScrollViewer><StackPanel Spacing="9"><TextBlock Classes="section" Text="طلب جديد" /><TextBox Text="{Binding CustomOrderDueText}" PlaceholderText="موعد التسليم: 2026-09-15 18:30" /><TextBox Text="{Binding CustomOrderDescription}" PlaceholderText="ملاحظات الطلب" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" /><TextBlock Text="الأصناف بأسعار هذا العميل" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding CafePriceRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto,150"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding PriceText, StringFormat='السعر: {0} ج.م'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" Margin="12,0" /><TextBox Grid.Column="2" Text="{Binding QuantityText}" HorizontalContentAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="الفاتورة تستخدم هذه الأسعار كما هي ولن تتغير إذا عدّلت القائمة لاحقاً." Classes="caption" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Classes="secondary" Content="إلغاء" Command="{Binding CancelCafeActionCommand}" /><Button Grid.Column="1" Classes="primary" Content="حفظ الطلب" Command="{Binding CreateCustomOrderCommand}" /></Grid></StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>

    <!-- Catalog and stock -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsCatalogVisible}">
      <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="title" Text="الأصناف" /><Expander Header="ملخص الأصناف"><TextBlock Text="{Binding CatalogSummaryText}" Foreground="#806070" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander></StackPanel><Button Grid.Column="1" Classes="primary" Content="+ صنف جديد" Command="{Binding NewCatalogItemCommand}" /></Grid></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.45*,*" ColumnSpacing="12">
        <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="اختر صنفاً" /><ListBox Grid.Row="1" ItemsSource="{Binding CatalogRows}" SelectedItem="{Binding SelectedCatalogItem}" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding AvailableText}" Classes="caption" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="{Binding PriceText}" Foreground="#D94F83" FontWeight="Bold" /><TextBlock Text="{Binding ActiveText}" Classes="caption" HorizontalAlignment="Left" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <Border Grid.Column="1" Classes="card" IsVisible="{Binding IsCatalogEditorClosed}"><TextBlock Text="اختر صنفاً لعرضه وتعديله، أو اضغط «صنف جديد»." TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="18" Foreground="#806070" /></Border>
        <Border Grid.Column="1" Classes="card" IsVisible="{Binding IsCatalogEditorOpen}"><ScrollViewer><StackPanel Spacing="9"><TextBlock Classes="section" Text="{Binding CatalogEditorTitle}" /><TextBlock Text="اسم الصنف" FontWeight="SemiBold" /><TextBox Text="{Binding CatalogName}" PlaceholderText="اسم الصنف" /><TextBlock Text="الوحدة" FontWeight="SemiBold" /><TextBox Text="{Binding CatalogUnit}" PlaceholderText="قطعة" /><TextBlock Text="سعر البيع (ج.م) *" FontWeight="Bold" FontSize="18" Foreground="#6D2944" /><TextBox Text="{Binding CatalogPriceText}" PlaceholderText="أدخل السعر، مثال: 120.00" FontSize="20" /><Button Classes="primary" Content="حفظ الصنف والسعر" Command="{Binding SaveCatalogItemCommand}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Classes="secondary" Content="أرشفة" Command="{Binding ArchiveCatalogItemCommand}" IsEnabled="{Binding CanArchiveCatalogItem}" /><Button Grid.Column="1" Classes="danger" Content="حذف" Command="{Binding DeleteCatalogItemCommand}" /></Grid></StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>

    <!-- One Wared workspace: request and receive are internal tabs -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsRequestVisible}">
      <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Classes="title" Text="وارد" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="طلب" Command="{Binding ShowRequestCommand}" /><Button Classes="secondary" Content="استلام" Command="{Binding ShowIncomingCommand}" IsVisible="{Binding HasIncomingShipments}" /></StackPanel><Expander Header="حالة الطلبات"><TextBlock Text="{Binding RequestStatusText}" TextWrapping="Wrap" Foreground="#6D2944" Margin="0,8,0,0" /></Expander></StackPanel></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.2*,*" ColumnSpacing="12">
        <Border Classes="card"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Classes="section" Text="ماذا يحتاج الفرع؟" /><ListBox Grid.Row="1" ItemsSource="{Binding RequestRows}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="2*,*,130,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding AvailableText, StringFormat='المتاح حالياً: {0}'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" /><TextBox Grid.Column="2" Text="{Binding QuantityText}" HorizontalContentAlignment="Center" /><Button Grid.Column="3" Content="+" Classes="secondary" Command="{Binding $parent[Window].DataContext.AddRequestLineCommand}" CommandParameter="{Binding}" Margin="8,0,0,0" MinWidth="48" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Classes="primary" Content="حفظ الطلب وإرساله" Command="{Binding SubmitRequestCommand}" HorizontalAlignment="Stretch" /></Grid></Border>
        <Border Grid.Column="1" Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="الطلبات السابقة" /><ListBox Grid.Row="1" ItemsSource="{Binding RequestHistoryRows}" SelectedItem="{Binding SelectedRequest}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Expander Margin="0,3"><Expander.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Reference}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#D94F83" FontWeight="Bold" Margin="14,0" /></Grid></Expander.Header><Border Classes="soft" Margin="0,6,0,0"><StackPanel Spacing="3"><TextBlock Text="{Binding RequestedText}" TextWrapping="Wrap" /><TextBlock Text="{Binding FulfillmentText}" Classes="caption" /></StackPanel></Border></Expander></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      </Grid>
    </Grid>

    <!-- Incoming shipment receiving -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsIncomingVisible}">
      <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Classes="title" Text="وارد" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="طلب" Command="{Binding ShowRequestCommand}" /><Button Classes="primary" Content="استلام" Command="{Binding ShowIncomingCommand}" /></StackPanel><Expander Header="حالة الاستلام"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding IncomingStatusText}" TextWrapping="Wrap" Foreground="#6D2944" /><TextBlock Text="إذا اختلف العد، تتوقف الشحنة للمراجعة." Classes="caption" /></StackPanel></Expander></StackPanel></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.05*,*" RowDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="الشحنات" /><ListBox Grid.Row="1" ItemsSource="{Binding IncomingRows}" SelectedItem="{Binding SelectedIncoming}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Reference}" FontWeight="SemiBold" /><TextBlock Text="{Binding DispatchedText}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#D94F83" FontWeight="Bold" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <Border Grid.Column="1" Classes="card"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Classes="section" Text="اضغط على شحنة لعدّها" /><ListBox Grid.Row="1" ItemsSource="{Binding IncomingCountRows}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="2*,140"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding SentText, StringFormat='المرسل: {0}'}" Classes="caption" /></StackPanel><TextBox Grid.Column="1" Text="{Binding QuantityText}" HorizontalContentAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Classes="primary" Content="استلام" Command="{Binding ReceiveShipmentCommand}" HorizontalAlignment="Stretch" /></Grid></Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="section" Text="إضافة وارد يدوي بدون طلب" /><TextBlock Classes="caption" Text="أدخل الكميات ومصدر الوارد؛ تُضاف مرة واحدة وتُزامن مع لوحة الإدارة." /></StackPanel><TextBox Grid.Row="1" Text="{Binding ManualIncomingReason}" PlaceholderText="المصدر أو السبب" Margin="0,8,0,0"/><Button Grid.Row="1" Grid.Column="1" Classes="primary" Content="إضافة الوارد ومزامنته" Command="{Binding PostManualIncomingCommand}" Margin="8,8,0,0"/><ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" MaxHeight="220" Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding ManualIncomingRows}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="2*,120" Margin="0,3"><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding QuantityText}" HorizontalContentAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
      </Grid>
    </Grid>

    <!-- Current shift history and append-only corrections -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsShiftHistoryVisible}">
      <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Classes="title" Text="نقطة البيع" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="البيع" Command="{Binding ResumeShiftCommand}" /><Button Classes="primary" Content="حركات الوردية" Command="{Binding ShowShiftHistoryCommand}" /><Button Classes="secondary" Content="مرتجع للمطبخ" Command="{Binding ShowReturnCommand}" /><Button Classes="secondary" Content="إغلاق الوردية" Command="{Binding ShowCloseCommand}" /></StackPanel><Expander Header="ملخص الوردية"><TextBlock Text="{Binding ShiftHistorySummaryText}" TextWrapping="Wrap" Foreground="#6D2944" Margin="0,8,0,0" /></Expander></StackPanel></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.05*,*" ColumnSpacing="12">
        <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Classes="section" Text="الإيصالات" /><ListBox Grid.Row="1" ItemsSource="{Binding SaleRows}" SelectedItem="{Binding SelectedSale}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ReceiptNumber}" FontWeight="SemiBold" /><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalText}" FontWeight="Bold" Foreground="#D94F83" /><TextBlock Text="{Binding StatusText}" Classes="caption" HorizontalAlignment="Left" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasNoSelectedSale}"><TextBlock Text="اختر إيصالاً لعرض تفاصيله أو إرجاع صنف منه." TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="18" Foreground="#806070" /></Border>
        <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasSelectedSale}"><ScrollViewer><StackPanel Spacing="10">
          <TextBlock Classes="section" Text="إرجاع من الإيصال" />
          <ListBox ItemsSource="{Binding SaleDetailLines}" SelectedItem="{Binding SelectedSaleLine}" MinHeight="180"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding OriginalText, StringFormat='الأصلي: {0}'}" Classes="caption" /><TextBlock Text="{Binding RefundedText, StringFormat='المسترد: {0}'}" Classes="caption" /><TextBlock Text="{Binding RemainingText, StringFormat='المتبقي: {0}'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding EffectiveTotalText}" FontWeight="Bold" Foreground="#D94F83" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Text="الكمية المراد استردادها" /><TextBox Text="{Binding CorrectionQuantityText}" />
          <TextBlock Text="سبب التصحيح" /><TextBox Text="{Binding CorrectionReason}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" />
          <CheckBox Content="إعادة الكمية إلى المخزون القابل للبيع" IsChecked="{Binding RestockCorrection}" />
          <StackPanel Orientation="Horizontal" Spacing="8"><RadioButton Content="رد كاش" GroupName="refund" IsChecked="{Binding IsRefundCash}" /><RadioButton Content="رد فيزا" GroupName="refund" IsChecked="{Binding IsRefundVisa}" /></StackPanel>
          <Button Classes="danger" Content="إرجاع الصنف ورد المبلغ" Command="{Binding RefundSaleCommand}" />
          <TextBlock Text="{Binding ShiftHistorySummaryText}" TextWrapping="Wrap" Foreground="#6D2944" />
          <Button Classes="secondary" Content="إعادة طباعة الإيصال المحدد" Command="{Binding ReprintSaleCommand}" />
        </StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>

    <!-- Kitchen return -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsReturnVisible}">
      <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Classes="title" Text="نقطة البيع" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="البيع" Command="{Binding ResumeShiftCommand}" /><Button Classes="secondary" Content="حركات الوردية" Command="{Binding ShowShiftHistoryCommand}" /><Button Classes="primary" Content="مرتجع للمطبخ" Command="{Binding ShowReturnCommand}" /><Button Classes="secondary" Content="إغلاق الوردية" Command="{Binding ShowCloseCommand}" /></StackPanel><Expander Header="حالة المرتجعات"><TextBlock Text="{Binding ReturnStatusText}" TextWrapping="Wrap" Foreground="#6D2944" Margin="0,8,0,0" /></Expander></StackPanel></Border>
      <Border Grid.Row="1" Classes="card" MaxWidth="980" HorizontalAlignment="Center"><Grid RowDefinitions="Auto,*,Auto,Auto"><TextBlock Classes="section" Text="حدد الكميات المرتجعة" /><ListBox Grid.Row="1" ItemsSource="{Binding ReturnRows}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="2*,*,130,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding AvailableText, StringFormat='المتاح: {0}'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" /><TextBox Grid.Column="2" Text="{Binding QuantityText}" HorizontalContentAlignment="Center" /><Button Grid.Column="3" Content="+" Classes="secondary" Command="{Binding $parent[Window].DataContext.AddReturnLineCommand}" CommandParameter="{Binding}" Margin="8,0,0,0" MinWidth="48" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Row="2" Text="{Binding ReturnReason}" PlaceholderText="سبب المرتجع (إجباري)" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Margin="0,8" /><Button Grid.Row="3" Classes="danger" Content="تأكيد وإرسال المرتجع" Command="{Binding SubmitReturnCommand}" HorizontalAlignment="Stretch" /></Grid></Border>
    </Grid>

    <!-- Four-step shift close -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20" IsVisible="{Binding IsCloseVisible}">
      <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="title" Text="نقطة البيع" /><TextBlock Text="{Binding CloseStepText}" Foreground="#D94F83" FontWeight="Bold" /><Expander Header="ملخص الإغلاق"><TextBlock Text="{Binding ClosingSummaryText}" TextWrapping="Wrap" Foreground="#806070" Margin="0,8,0,0" /></Expander></StackPanel><TextBlock Grid.Column="1" Text="لا يمكن تعديل الوردية بعد الإغلاق" Foreground="#B4233A" VerticalAlignment="Center" /></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="البيع" Command="{Binding ResumeShiftCommand}" /><Button Classes="secondary" Content="حركات الوردية" Command="{Binding ShowShiftHistoryCommand}" /><Button Classes="secondary" Content="مرتجع للمطبخ" Command="{Binding ShowReturnCommand}" /><Button Classes="primary" Content="إغلاق الوردية" Command="{Binding ShowCloseCommand}" /></StackPanel></StackPanel></Border>
      <Border Grid.Row="1" Classes="card"><Grid>
        <Grid IsVisible="{Binding IsCloseStep1}" RowDefinitions="Auto,*,Auto,Auto"><StackPanel><TextBlock Classes="section" Text="1 — أضف مرتجع المطبخ" /><TextBlock Text="حدد ما سيعود للمطبخ الآن. يُخصم مرة واحدة قبل حساب المتبقي النهائي." Classes="caption" TextWrapping="Wrap" /><TextBlock Text="{Binding ClosingReturnReviewText}" TextWrapping="Wrap" Foreground="#6D2944" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ReturnRows}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="2*,*,130,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding AvailableText, StringFormat='المتاح: {0}'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" /><TextBox Grid.Column="2" Text="{Binding QuantityText}" HorizontalContentAlignment="Center" /><Button Grid.Column="3" Content="+" Classes="secondary" Command="{Binding $parent[Window].DataContext.AddReturnLineCommand}" CommandParameter="{Binding}" Margin="8,0,0,0" MinWidth="48" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Row="2" Text="{Binding ReturnReason}" PlaceholderText="سبب المرتجع" Margin="0,6" /><Button Grid.Row="3" Classes="danger" Content="إضافة المرتجع قبل الإغلاق" Command="{Binding SubmitReturnCommand}" HorizontalAlignment="Stretch" /></Grid>
        <Grid IsVisible="{Binding IsCloseStep2}" RowDefinitions="Auto,*"><StackPanel><TextBlock Classes="section" Text="2 — المتبقي المحسوب تلقائياً" /><TextBlock Text="لكل صنف: افتتاحية الوردية، الوارد المؤكد، والمتبقي. الوارد المعلّق لا يدخل في الرصيد." Classes="caption" TextWrapping="Wrap" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ClosingRows}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Classes="soft" Margin="0,3"><Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding OpeningText, StringFormat='افتتاحية: {0}'}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding IncomingText, StringFormat='وارد: {0}'}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding ExpectedText, StringFormat='المتبقي: {0}'}" FontWeight="Bold" Foreground="#D94F83" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        <StackPanel IsVisible="{Binding IsCloseStep3}" Spacing="16" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Classes="section" Text="3 — مراجعة الفروق والنقدية" HorizontalAlignment="Center" /><Border Classes="soft"><TextBlock Text="{Binding CloseReportText}" TextWrapping="Wrap" FontSize="18" /></Border><TextBlock Text="أدخل إجمالي النقدية الفعلية الموجودة بالخزنة. فرق العد ينتظر اعتماد الإدارة ولا يغير الرصيد تلقائياً." TextWrapping="Wrap" TextAlignment="Center" /><TextBox Text="{Binding ActualCashText}" PlaceholderText="0.00 ج.م" FontSize="24" HorizontalContentAlignment="Center" /></StackPanel>
        <StackPanel IsVisible="{Binding IsCloseStep4}" Spacing="16" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Classes="section" Text="4 — الملخص والتأكيد النهائي" HorizontalAlignment="Center" /><Border Classes="soft"><TextBlock Text="{Binding ClosingSummaryText}" TextWrapping="Wrap" FontSize="18" /></Border><TextBlock Text="سيتم إغلاق الوردية بشكل نهائي بالكميات المحسوبة تلقائياً وإنشاء تقرير Excel." TextWrapping="Wrap" TextAlignment="Center" FontSize="17" /><Button Classes="danger" Content="إنهاء الوردية الآن" Command="{Binding CloseShiftCommand}" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding CloseReportText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#18794E" /></StackPanel>
      </Grid></Border>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0"><Button Classes="secondary" Content="السابق" Command="{Binding PreviousCloseStepCommand}" /><TextBlock Grid.Column="1" Text="{Binding CloseStepText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /><Button Grid.Column="2" Classes="primary" Content="التالي" Command="{Binding AdvanceCloseStepCommand}" /></Grid>
    </Grid>

    <!-- Simple user settings -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettingsVisible}">
      <StackPanel Margin="28" Spacing="14" MaxWidth="760" HorizontalAlignment="Center">
        <TextBlock Classes="title" Text="الإعدادات" />
        <Border Classes="card" IsVisible="{Binding NeedsEnrollment}"><StackPanel Spacing="12"><TextBlock Classes="section" Text="ربط الجهاز بالخادم" /><TextBlock Text="لإرسال المبيعات والورديات إلى الخادم، اربط هذا الجهاز مرة واحدة. لا يوجد ترخيص مدفوع." TextWrapping="Wrap" /><TextBlock Text="عنوان الخادم" /><TextBox Text="{Binding ApiBaseUrl}" PlaceholderText="https://ascendyz.xyz/api/v1" /><TextBlock Text="اسم الجهاز" /><TextBox Text="{Binding DeviceName}" PlaceholderText="اسم هذا الجهاز" /><TextBlock Text="رمز الربط" /><TextBox Text="{Binding EnrollmentToken}" PlaceholderText="رمز ربط الجهاز من الإدارة" /><Button Classes="primary" Content="ربط الجهاز" Command="{Binding EnrollCommand}" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding StatusMessage}" Classes="error" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="section" Text="الاتصال" /><TextBox Text="{Binding ApiBaseUrl}" PlaceholderText="عنوان الاتصال" /><TextBlock Classes="section" Text="ملف Excel" Margin="0,10,0,0" /><TextBox Text="{Binding ExportDirectory}" PlaceholderText="مكان حفظ التقرير" /><Button Classes="primary" Content="حفظ" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding SettingsStatusText}" Foreground="#6D2944" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Classes="card" IsVisible="{Binding HasPendingReport}"><StackPanel Spacing="8"><TextBlock Classes="section" Text="تقرير يحتاج إعادة محاولة" /><TextBlock Text="{Binding PendingReportText}" TextWrapping="Wrap" /><TextBlock Text="هذه أداة استعادة للتقرير فقط؛ سجل الورديات الكامل متاح في لوحة الإدارة." Classes="caption" TextWrapping="Wrap" /><Button Classes="primary" Content="إعادة إنشاء تقرير Excel" Command="{Binding RetryReportCommand}" /></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
