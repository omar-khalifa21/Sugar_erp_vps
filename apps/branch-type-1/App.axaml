<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SugarERP.Branch1.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SugarERP.Desktop.Shared/Styles/TouchStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Background" Value="#FFF5F8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Window.touch Button">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Window.touch TextBox">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Window.touch ComboBox, Window.touch RadioButton">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#6D2944" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#6D2944" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6D2944" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#806070" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#B4233A" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#765D68" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#6D2944" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6D2944" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#806070" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#B4233A" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E9D9DE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 4 18 0 #22000000" />
    </Style>
    <Style Selector="Border.soft">
      <Setter Property="Background" Value="#FFF8FA" />
      <Setter Property="BorderBrush" Value="#F2D7E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.soft">
      <Setter Property="Background" Value="#FFF9FB" />
      <Setter Property="BorderBrush" Value="#F0DDE5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Styles>
</Application>
