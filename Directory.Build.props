<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SugarErpApiBaseUrl Condition="'$(SugarErpApiBaseUrl)' == ''">https://ascendyz.xyz/api/v1</SugarErpApiBaseUrl>
    <SugarErpEnvironment Condition="'$(SugarErpEnvironment)' == ''">Production</SugarErpEnvironment>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SugarErpApiBaseUrl</_Parameter1>
      <_Parameter2>$(SugarErpApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SugarErpEnvironment</_Parameter1>
      <_Parameter2>$(SugarErpEnvironment)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
