{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugar-erp.local/contracts/v1/api-error.schema.json",
  "title": "Sugar ERP API error",
  "type": "object",
  "additionalProperties": true,
  "required": ["code", "message", "correlation_id", "retryable"],
  "properties": {
    "code": { "type": "string", "minLength": 2 },
    "message": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "field_errors": { "type": "array", "items": { "type": "string" } },
    "current_version": { "type": "integer", "minimum": 1 },
    "expected_sequence": { "type": "integer", "minimum": 1 }
  }
}
