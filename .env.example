# Development only. Copy to .env and choose non-production values.
POSTGRES_DB=sugar_erp
POSTGRES_USER=sugar_erp
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://sugar_erp:replace-with-a-local-password@localhost:5434/sugar_erp?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=replace-with-a-development-password
DEV_SEED_SYNTHETIC=true
ADMIN_WEB_PORT=4173
PORT=3000
