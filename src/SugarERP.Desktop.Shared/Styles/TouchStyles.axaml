<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.touch">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#D94F83" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#F8C8D8" />
    <Setter Property="Foreground" Value="#4B1F30" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#C9364E" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.product-card">
    <Setter Property="Width" Value="190" />
    <Setter Property="Height" Value="142" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#F2D7E1" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox.touch">
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style Selector="RadioButton.touch">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="15" />
  </Style>
</Styles>
