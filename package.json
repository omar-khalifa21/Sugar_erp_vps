{
  "name": "sugar-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Sugar ERP monorepo",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace @sugar-erp/server",
    "build:admin": "npm run build --workspace @sugar-erp/admin-web",
    "dev:admin": "npm run dev --workspace @sugar-erp/admin-web",
    "format": "npm run format --workspace @sugar-erp/server",
    "lint": "npm run lint --workspace @sugar-erp/server",
    "test": "npm run test --workspace @sugar-erp/server",
    "test:integration": "npm run test:integration --workspace @sugar-erp/server",
    "typecheck": "npm run typecheck --workspace @sugar-erp/server",
    "prisma:generate": "npm run prisma:generate --workspace @sugar-erp/server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @sugar-erp/server",
    "bootstrap:admin": "npm run bootstrap:admin --workspace @sugar-erp/server"
  }
}
